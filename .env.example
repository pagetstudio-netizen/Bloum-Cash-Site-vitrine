# ============================================================
# Bloum Cash — Variables d'environnement requises
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de données PostgreSQL (obligatoire) ─────────────────
# Utilisez SUPABASE_DATABASE_URL (prioritaire sur DATABASE_URL)
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/bloumcash

# ── Compte administrateur (obligatoire au premier démarrage) ─
# Le compte est créé UNE SEULE FOIS au démarrage si absent.
# Après la création, changer le mot de passe directement en base.
# Ne jamais committer ces valeurs dans git.
ADMIN_EMAIL=votre-email@exemple.com
ADMIN_PASSWORD=MotDePasseForte1234!

# ── Sécurité JWT (obligatoire en production) ─────────────────
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 caractères aléatoires. OBLIGATOIRE en production.
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-secrete-de-32-chars-minimum

# ── Bot Telegram pour les notifications de contact (optionnel) ─
# Obtenez un token via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=votre_token_telegram_bot

# Code secret pour enregistrer un groupe Telegram comme destinataire.
# Dans Telegram, envoyez : /register VOTRE_CODE_SECRET
# Choisissez un code fort — quiconque le connaît peut enregistrer n'importe quel groupe.
TELEGRAM_REGISTER_CODE=changez-ce-code-secret

# ── Optionnel ────────────────────────────────────────────────
# Origines CORS supplémentaires autorisées en production (séparées par virgule)
# ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Chemin vers les fichiers statiques du frontend (défaut auto)
# STATIC_PATH=/chemin/absolu/vers/les/fichiers/statiques
