# ============================================================
# Bloum Cash — Variables d'environnement requises
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Serveur
NODE_ENV=production
PORT=3000

# Base de données PostgreSQL (obligatoire)
DATABASE_URL=postgresql://user:password@localhost:5432/bloumcash

# Sécurité JWT pour le panel admin (obligatoire)
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-secrete

# Bot Telegram pour les notifications de contact (obligatoire)
TELEGRAM_BOT_TOKEN=votre_token_telegram_bot

# Optionnel — Chemin vers les fichiers statiques du frontend
# Par défaut: artifacts/api-server/dist/public (copié automatiquement par le build)
# STATIC_PATH=/chemin/absolu/vers/les/fichiers/statiques
